{
  "name": "deck.gl-cog-with-editor-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:editing-isolation": "node scripts/check-editing-isolation.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:consumer": "pnpm exec tsc --noEmit -p test-consumer",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check:editing-isolation && pnpm typecheck && pnpm typecheck:consumer && pnpm test && pnpm build",
    "publish": "pnpm build && gh-pages -d dist -b gh-pages -e examples/cog-with-editor"
  },
  "dependencies": {
    "@deck.gl-community/editable-layers": "^9.3.2",
    "@deck.gl-community/layers": "^9.3.2",
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/extensions": "^9.3.1",
    "@deck.gl/geo-layers": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@deck.gl/mesh-layers": "^9.3.1",
    "@developmentseed/deck.gl-geotiff": "workspace:^",
    "@ngageoint/geopackage": "^4.2.6",
    "@luma.gl/constants": "^9.3.3",
    "@luma.gl/core": "^9.3.3",
    "@luma.gl/engine": "^9.3.3",
    "h3-js": "^4.2.1",
    "maplibre-gl": "^5.19.0",
    "proj4": "^2.20.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
